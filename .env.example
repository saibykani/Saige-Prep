# Copy to backend/.env and fill in. Never commit the real file.
APP_ENV=development
APP_NAME=Saige-Prep

# Local MongoDB (Windows service or `docker compose up -d mongo`), or your Atlas SRV string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=saige_prep

# Origin of the Next.js app (must be https in production)
FRONTEND_ORIGIN=http://localhost:3002

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=168

# Login throttling (per account)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Optional AI — disabled by default; everything works without it
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Frontend (frontend/.env.local): where Next.js rewrites /api to. Read at build time.
# BACKEND_URL=http://127.0.0.1:8010
