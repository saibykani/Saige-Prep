    "lucide-react": "1.57.0",
    "mermaid": "12.2.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sql.js": "1.15.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
